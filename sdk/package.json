{
  "name": "@spidey52/api-logs-sdk",
  "version": "1.0.9",
  "description": "Batched API log exporter (axios) + optional Hono / Express middleware",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "axios": ">=1.6.0",
    "hono": ">=4.0.0",
    "express": ">=4.18.0",
    "ioredis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "axios": "^1.7.9",
    "express": "^4.21.0",
    "hono": "^4.10.7",
    "typescript": "~5.7.0"
  },
  "license": "MIT",
  "keywords": [
    "api-logs",
    "hono",
    "express",
    "axios",
    "observability"
  ]
}